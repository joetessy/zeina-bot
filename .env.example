# ─── LLM backend (OpenAI-compatible) ─────────────────────────────────────────
# Zeina talks to any OpenAI-compatible server. Point it at whatever you run:
#   • llama.cpp / llama-swap : http://localhost:9292/v1   (default)
#   • Ollama                 : http://localhost:11434/v1
#   • LM Studio              : http://localhost:1234/v1
#   • a cloud provider       : that provider's /v1 base URL
ZEINA_LLM_BASE_URL=http://localhost:9292/v1

# Most local servers ignore the key, but a non-empty value is required.
# For a cloud provider, put your real key here.
ZEINA_LLM_API_KEY=local

# Model ids must match what the server reports at GET /v1/models.
ZEINA_CHAT_MODEL=qwen2.5-7b
ZEINA_VISION_MODEL=huihui-qwen3.6-27b-abliterated-mtp
# Optional: a cheaper model for summaries/memory extraction (defaults to CHAT_MODEL).
# ZEINA_ROUTER_MODEL=

# Optional request tuning.
# ZEINA_LLM_TIMEOUT=120
# ZEINA_LLM_MAX_RETRIES=2

# ─── Optional self-hosted services (default to local/standalone) ─────────────
# Private web search via a SearXNG instance. If unset, DuckDuckGo (ddgs) is used.
# If set but unreachable, Zeina falls back to DuckDuckGo automatically.
# ZEINA_SEARXNG_URL=http://localhost:8080

# ─── Tool API keys (optional) ────────────────────────────────────────────────
# Free weather key: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_key_here
